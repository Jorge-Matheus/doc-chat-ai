# Copy this file to .env and change the values. Never commit .env.

# Database. Set POSTGRES_PASSWORD: it has no default on purpose, and Compose refuses to start without it.
POSTGRES_DB=docchat
POSTGRES_USER=docchat
POSTGRES_PASSWORD=

# Host ports, bound to 127.0.0.1 only.
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200
OLLAMA_PORT=11434
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
